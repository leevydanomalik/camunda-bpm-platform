# Camunda engine REST endpoint (Java) — proxied by Next.js as /api/engine/*
CAMUNDA_ENGINE_REST_URL=http://localhost:8080/engine-rest

# Default engine name used when none is in the URL (Camunda's "default" engine)
CAMUNDA_DEFAULT_ENGINE=default

# Auth (Phase 0): NextAuth secret + session cookie name
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
AUTH_SESSION_COOKIE=camunda-next.session

# Plugin loader — comma-separated list of plugin ids / extension-point keys to disable.
# Mirrors today's <base cam-exclude-plugins="..."> attribute.
# Example: CAMUNDA_EXCLUDE_PLUGINS=external-tasks-tab,cockpit.processInstance.runtime.tab:some-id
CAMUNDA_EXCLUDE_PLUGINS=
